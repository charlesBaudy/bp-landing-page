---
import Layout from '../layouts/Layout.astro';
import Portfolio from '../components/Portfolio.astro';

---

<Layout 
  title="Nos Réalisations | Baudy Peinture Toulon"
  description="Découvrez nos réalisations de peinture à Toulon et ses environs. Projets résidentiels et commerciaux, avant/après, témoignages clients."
>
  <main>
    <div class="page-header">
      <div class="container">
        <p class="eyebrow">Notre travail</p>
        <h1>Réalisations</h1>
        <p class="sub">Des projets qui parlent d'eux-mêmes</p>
      </div>
    </div>
    <Portfolio />
    <section class="testimonials">
      <div class="container">
        <p class="eyebrow reveal">Ce qu'ils disent</p>
        <h2 class="reveal">Témoignages clients</h2>
        <div class="testimonials-grid">
          <blockquote class="testimonial reveal reveal-delay-1">
            <p>"Travail soigné et professionnel. Je recommande vivement Baudy Peinture pour la qualité de leur prestation."</p>
            <cite>Marie L. — La Seyne-sur-Mer</cite>
          </blockquote>
          <blockquote class="testimonial reveal reveal-delay-2">
            <p>"Excellent rapport qualité-prix. L'équipe est ponctuelle et respectueuse des lieux."</p>
            <cite>Pierre D. — Toulon</cite>
          </blockquote>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  main { padding-top: 0; }

  .page-header {
    background: var(--bg-dark);
    padding: 10rem 0 5rem;
  }
  .eyebrow {
    color: var(--accent-light);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }
  .page-header h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.5rem, 6vw, 5rem);
    color: white;
    margin-bottom: 0.75rem;
  }
  .sub {
    color: rgba(255,255,255,0.5);
    font-size: 1rem;
  }

  .testimonials {
    padding: 7rem 0;
    background: var(--bg-dark);
  }
  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
  }
  h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    color: white;
    margin-bottom: 3rem;
  }
  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }
  .testimonial {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    padding: 2rem;
    border-radius: 12px;
    margin: 0;
  }
  .testimonial p {
    font-style: italic;
    color: rgba(255,255,255,0.7);
    line-height: 1.7;
    margin-bottom: 1.25rem;
    font-size: 1rem;
  }
  .testimonial cite {
    color: var(--accent-light);
    font-style: normal;
    font-size: 0.85rem;
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .testimonials { padding: 4rem 0; }
    .testimonials-grid { grid-template-columns: 1fr; }
    h2 { margin-bottom: 2rem; }
    .testimonial { padding: 1.5rem; }
  }
</style>