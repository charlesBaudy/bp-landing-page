---
import Layout from '../../layouts/Layout.astro';
import Contact from '../../components/Contact.astro';

const city = "Toulon";
const postalCode = "83000";
const slug = "toulon";

const neighborhoods = ["Haute-Ville", "Le Mourillon", "Saint-Jean-du-Var", "Pont-du-Las", "Basse-Ville", "Font-Pré", "Les Routes", "Cap Brun"];

const services = [
  {
    title: "Peinture Intérieure à Toulon",
    description: "Appartements haussmanniens, résidences modernes du centre-ville ou maisons de quartier — nous adaptons nos techniques aux spécificités de chaque logement toulonnais. Préparation des supports, enduit, finitions mate ou satinée.",
  },
  {
    title: "Peinture Extérieure & Façades",
    description: "Le climat méditerranéen de Toulon exige des peintures extérieures résistantes au sel, au soleil et aux variations thermiques. Nous utilisons des produits professionnels adaptés aux façades du littoral varois.",
  },
  {
    title: "Rénovation & Ravalement",
    description: "Ravalement de façade, rebouchage de fissures, traitement des remontées d'humidité — des problématiques fréquentes dans les immeubles anciens de la Haute-Ville et du centre historique de Toulon.",
  },
];

const faq = [
  {
    q: "Quel est le prix d'une peinture d'appartement à Toulon ?",
    a: "Pour un appartement à Toulon, comptez entre 20 et 45 €/m² selon l'état des murs et les finitions. Un studio de 30 m² revient généralement entre 600 et 1 200 €. Le devis est gratuit et établi après visite.",
  },
  {
    q: "Intervenez-vous dans tous les quartiers de Toulon ?",
    a: "Oui, nous intervenons dans tous les quartiers de Toulon : Haute-Ville, Le Mourillon, Saint-Jean-du-Var, Pont-du-Las, Font-Pré, Cap Brun, Basse-Ville et les zones industrielles pour les locaux commerciaux.",
  },
  {
    q: "Quelle peinture pour une salle de bain à Toulon ?",
    a: "En raison du taux d'humidité élevé, nous recommandons des peintures microporeuses ou des finitions en résine époxy. Nous traitons également les éventuelles moisissures avant application pour un résultat durable.",
  },
  {
    q: "Travaillez-vous le samedi à Toulon ?",
    a: "Oui, nous intervenons le samedi sur rendez-vous pour les clients de Toulon et ses environs. Contactez-nous pour convenir d'un créneau adapté à votre agenda.",
  },
];

const nearbyZones = [
  { name: "La Seyne-sur-Mer", href: "/zones/la-seyne-sur-mer" },
  { name: "La Valette-du-Var", href: "/zones/la-valette-du-var" },
  { name: "Six-Fours-les-Plages", href: "/zones/six-fours-les-plages" },
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.baudypeinture.fr/" },
    { "@type": "ListItem", "position": 2, "name": "Zones d'intervention", "item": "https://www.baudypeinture.fr/" },
    { "@type": "ListItem", "position": 3, "name": city, "item": `https://www.baudypeinture.fr/zones/${slug}` },
  ]
};

const localSchema = {
  "@context": "https://schema.org",
  "@type": "PaintingContractor",
  "name": "Baudy Peinture",
  "url": `https://www.baudypeinture.fr/zones/${slug}`,
  "telephone": "+33620156410",
  "email": "contact@baudypeinture.fr",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": city,
    "postalCode": postalCode,
    "addressRegion": "Provence-Alpes-Côte d'Azur",
    "addressCountry": "FR"
  },
  "areaServed": { "@type": "City", "name": city },
  "description": `Artisan peintre professionnel à ${city}. Peinture intérieure, extérieure, ravalement de façade. Devis gratuit.`,
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faq.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": { "@type": "Answer", "text": item.a }
  }))
};
---

<Layout
  title={`Peintre à Toulon (83) | Baudy Peinture — Artisan Var`}
  description={`Artisan peintre à Toulon (83000). Peinture intérieure, extérieure, ravalement de façade dans tous les quartiers. Devis gratuit sous 48h. Garantie décennale.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(localSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <main>
    <div class="page-header">
      <div class="container">
        <nav class="breadcrumb" aria-label="Fil d'Ariane">
          <a href="/">Accueil</a>
          <span>›</span>
          <a href="/#zones">Zones</a>
          <span>›</span>
          <span aria-current="page">{city}</span>
        </nav>
        <p class="eyebrow">Var (83) · {postalCode}</p>
        <h1>Artisan Peintre à {city}</h1>
        <p class="sub">Peinture intérieure, extérieure et rénovation — devis gratuit sous 48h</p>
        <div class="nap">
          <span>📞 <a href="tel:+33620156410">06 20 15 64 10</a></span>
          <span>📍 {city}, Var (83)</span>
        </div>
      </div>
    </div>

    <section class="content-section">
      <div class="container">
        <div class="intro reveal">
          <h2>Peintre professionnel à {city}</h2>
          <p>Baudy Peinture est votre artisan peintre de confiance à {city}. Fort de plus de 15 ans d'expérience dans le Var, nous intervenons dans tous les quartiers de la ville pour vos travaux de peinture intérieure et extérieure. Que vous rénoviez un appartement au Mourillon, une maison à Font-Pré ou un local commercial en centre-ville, nous apportons le même soin et la même exigence à chaque chantier.</p>
          <p>Notre connaissance du tissu urbain toulonnais — ses immeubles anciens, ses résidences modernes, ses villas en bord de mer — nous permet de vous conseiller les meilleures solutions techniques et esthétiques pour votre bien.</p>
        </div>

        <div class="services-grid">
          {services.map((s, i) => (
            <div class={`service-card reveal reveal-delay-${i+1}`}>
              <h3>{s.title}</h3>
              <p>{s.description}</p>
            </div>
          ))}
        </div>

        <div class="neighborhoods-block reveal">
          <h2>Nos quartiers d'intervention à {city}</h2>
          <div class="neighborhoods-grid">
            {neighborhoods.map(n => (
              <div class="neighborhood-item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
                <span>{n}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="faq-block reveal">
          <h2>Questions fréquentes — Peintre à {city}</h2>
          <div class="faq-list">
            {faq.map((item, i) => (
              <details class="faq-item" open={i === 0}>
                <summary class="faq-q">{item.q}</summary>
                <p class="faq-a">{item.a}</p>
              </details>
            ))}
          </div>
        </div>

        <div class="nearby reveal">
          <h2>Zones voisines</h2>
          <p>Nous intervenons également dans les communes proches de {city} :</p>
          <div class="nearby-grid">
            {nearbyZones.map(z => (
              <a href={z.href} class="nearby-link">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
                Peintre à {z.name} →
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <Contact />
  </main>
</Layout>

<style>
  main { padding-top: 0; }

  .page-header {
    background: var(--bg-dark);
    padding: 9rem 0 4rem;
  }
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: rgba(255,255,255,0.4);
    margin-bottom: 1.5rem;
  }
  .breadcrumb a { color: rgba(255,255,255,0.5); text-decoration: none; }
  .breadcrumb a:hover { color: var(--accent-light); }
  .eyebrow {
    color: var(--accent-light);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }
  .page-header h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.2rem, 5vw, 4rem);
    color: white;
    margin-bottom: 0.75rem;
  }
  .sub { color: rgba(255,255,255,0.5); font-size: 1rem; margin-bottom: 1.5rem; }
  .nap {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
    font-size: 0.9rem;
    color: rgba(255,255,255,0.6);
  }
  .nap a { color: var(--accent-light); text-decoration: none; }

  .content-section { padding: 5rem 0; background: var(--bg); }
  .container { max-width: 1280px; margin: 0 auto; padding: 0 2rem; }

  .intro { max-width: 820px; margin-bottom: 4rem; }
  .intro h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    color: var(--primary);
    margin-bottom: 1rem;
  }
  .intro p { color: var(--text-muted); line-height: 1.8; font-size: 1rem; margin-bottom: 1rem; }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-bottom: 4rem;
  }
  .service-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 2rem;
  }
  .service-card h3 {
    font-family: 'Playfair Display', serif;
    font-size: 1.1rem;
    color: var(--primary);
    margin-bottom: 0.75rem;
  }
  .service-card p { color: var(--text-muted); font-size: 0.9rem; line-height: 1.7; }

  .neighborhoods-block { margin-bottom: 4rem; }
  .neighborhoods-block h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    color: var(--primary);
    margin-bottom: 1.5rem;
  }
  .neighborhoods-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 0.75rem;
  }
  .neighborhood-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.65rem 1rem;
    font-size: 0.9rem;
    color: var(--text);
  }
  .neighborhood-item svg { color: var(--accent); flex-shrink: 0; }

  .faq-block { margin-bottom: 4rem; }
  .faq-block h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    color: var(--primary);
    margin-bottom: 1.5rem;
  }
  .faq-list { max-width: 760px; }
  .faq-item { border-bottom: 1px solid var(--border); }
  .faq-item:first-child { border-top: 1px solid var(--border); }
  .faq-q {
    list-style: none;
    padding: 1.25rem 0;
    font-weight: 600;
    color: var(--primary);
    font-size: 0.95rem;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  .faq-q::after { content: '+'; color: var(--accent); font-size: 1.4rem; font-weight: 300; flex-shrink: 0; transition: transform 0.2s; }
  .faq-item[open] .faq-q::after { transform: rotate(45deg); }
  .faq-q::-webkit-details-marker { display: none; }
  .faq-a { color: var(--text-muted); font-size: 0.9rem; line-height: 1.75; padding-bottom: 1.25rem; }

  .nearby h2 {
    font-family: 'Playfair Display', serif;
    font-size: 1.4rem;
    color: var(--primary);
    margin-bottom: 0.5rem;
  }
  .nearby > p { color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1rem; }
  .nearby-grid { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .nearby-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 100px;
    padding: 0.5rem 1.1rem;
    text-decoration: none;
    color: var(--accent);
    font-size: 0.85rem;
    font-weight: 500;
    transition: border-color 0.2s, background 0.2s;
  }
  .nearby-link:hover { border-color: var(--accent); background: #FDF8F3; }
  .nearby-link svg { color: var(--accent); }

  @media (max-width: 768px) {
    .page-header { padding: 6rem 0 3rem; }
    .content-section { padding: 3rem 0; }
    .nap { gap: 0.75rem; flex-direction: column; }
    .services-grid { grid-template-columns: 1fr; }
    .neighborhoods-grid { grid-template-columns: repeat(2, 1fr); }
    .neighborhoods-block, .faq-block { margin-bottom: 2.5rem; }
    .nearby-grid { gap: 0.5rem; }
    .nearby-link { min-height: 44px; }
    .intro { margin-bottom: 2.5rem; }
  }
  @media (max-width: 400px) {
    .neighborhoods-grid { grid-template-columns: 1fr; }
    .nearby-link { width: 100%; justify-content: center; }
  }
</style>
