---
import Layout from '../../layouts/Layout.astro';
import Contact from '../../components/Contact.astro';

const city = "Six-Fours-les-Plages";
const postalCode = "83140";
const slug = "six-fours-les-plages";

const neighborhoods = ["Le Brusc", "Les Lônes", "Reynier", "La Coudoulière", "Bonnegrâce", "Saint-Pierre", "Les Playes", "Toulon-plages"];

const services = [
  {
    "title": "Peinture Intérieure à Six-Fours",
    "description": "Villas, maisons individuelles, résidences secondaires — nous réalisons des peintures intérieures de qualité à Six-Fours-les-Plages. Préparation rigoureuse des surfaces, choix des couleurs, finitions impeccables pour des espaces de vie agréables."
  },
  {
    "title": "Peinture Extérieure & Façades",
    "description": "Les façades des villas de Six-Fours sont exposées aux vents marins et au soleil intense. Nous utilisons des peintures façade microporeuses et des enduits de protection adaptés au climat méditerranéen du Var."
  },
  {
    "title": "Ravalement & Rénovation",
    "description": "Ravalement de façade complet, enduits décoratifs à la chaux ou au mortier, traitement des fissures et infiltrations — nous redonnons un coup de neuf à vos extérieurs pour valoriser votre bien à Six-Fours-les-Plages."
  }
];

const faq = [
  {
    "q": "Quelle peinture pour l'extérieur d'une villa à Six-Fours-les-Plages ?",
    "a": "Pour une villa à Six-Fours exposée au soleil et aux vents marins, nous préconisons des peintures façade silicone ou acrylique haute durabilité, résistantes aux UV et imperméables. Un traitement anti-mousse préalable est souvent nécessaire sur les façades exposées au nord."
  },
  {
    "q": "Intervenez-vous pour les résidences secondaires à Six-Fours ?",
    "a": "Oui, nous intervenons régulièrement pour l'entretien et la rénovation des résidences secondaires à Six-Fours-les-Plages. Nous planifions les travaux en accord avec vos disponibilités et pouvons coordonner les accès en votre absence."
  },
  {
    "q": "Quel délai pour rénover une villa de 120 m² à Six-Fours ?",
    "a": "Pour une villa de 120 m² à Six-Fours, comptez 5 à 8 jours de travaux pour la peinture intérieure complète, selon l'état des murs et les finitions souhaitées. Le planning précis est établi au moment du devis."
  }
];

const nearbyZones = [{"name": "La Seyne-sur-Mer", "href": "/zones/la-seyne-sur-mer"}, {"name": "Toulon", "href": "/zones/toulon"}];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.baudypeinture.fr/" },
    { "@type": "ListItem", "position": 2, "name": "Zones d'intervention", "item": "https://www.baudypeinture.fr/" },
    { "@type": "ListItem", "position": 3, "name": city, "item": `https://www.baudypeinture.fr/zones/${slug}` },
  ]
};

const localSchema = {
  "@context": "https://schema.org",
  "@type": "PaintingContractor",
  "name": "Baudy Peinture",
  "url": `https://www.baudypeinture.fr/zones/${slug}`,
  "telephone": "+33620156410",
  "email": "contact@baudypeinture.fr",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": city,
    "postalCode": postalCode,
    "addressRegion": "Provence-Alpes-Côte d'Azur",
    "addressCountry": "FR"
  },
  "areaServed": { "@type": "City", "name": city },
  "description": `Artisan peintre professionnel à ${city}. Peinture intérieure, extérieure, ravalement de façade. Devis gratuit.`,
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faq.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": { "@type": "Answer", "text": item.a }
  }))
};
---

<Layout
  title="Peintre à Six-Fours-les-Plages (83140) | Baudy Peinture — Artisan Var"
  description="Artisan peintre à Six-Fours-les-Plages (83140). Peinture intérieure, extérieure, rénovation de villas. Devis gratuit sous 48h. Garantie décennale."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(localSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <main>
    <div class="page-header">
      <div class="container">
        <nav class="breadcrumb" aria-label="Fil d'Ariane">
          <a href="/">Accueil</a>
          <span>›</span>
          <a href="/#zones">Zones</a>
          <span>›</span>
          <span aria-current="page">{city}</span>
        </nav>
        <p class="eyebrow">Var (83) · {postalCode}</p>
        <h1>Artisan Peintre à {city}</h1>
        <p class="sub">Peinture intérieure, extérieure et rénovation de villas — devis gratuit sous 48h</p>
        <div class="nap">
          <span>📞 <a href="tel:+33620156410">06 20 15 64 10</a></span>
          <span>📍 {city}, Var (83)</span>
        </div>
      </div>
    </div>

    <section class="content-section">
      <div class="container">
        <div class="intro reveal">
          <h2>Votre peintre de confiance à {city}</h2>
          <p>Six-Fours-les-Plages, commune résidentielle du Var prisée pour ses calanques et ses villas, requiert une expertise particulière en matière de rénovation. Entre les résidences secondaires à entretenir, les villas exposées aux vents et les maisons de quartier, Baudy Peinture intervient avec les techniques adaptées à chaque contexte.</p>
          <p>Nous connaissons bien les spécificités des constructions de Six-Fours : les revêtements de façade exposés aux vents du large, les terrasses et murs périmétriques à traiter, ainsi que les finitions intérieures soignées que demandent les propriétaires exigeants de la commune.</p>
        </div>

        <div class="services-grid">
          {services.map((s, i) => (
            <div class={`service-card reveal reveal-delay-${i+1}`}>
              <h3>{s.title}</h3>
              <p>{s.description}</p>
            </div>
          ))}
        </div>

        <div class="neighborhoods-block reveal">
          <h2>Nos quartiers d'intervention à {city}</h2>
          <div class="neighborhoods-grid">
            {neighborhoods.map(n => (
              <div class="neighborhood-item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
                <span>{n}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="faq-block reveal">
          <h2>Questions fréquentes — Peintre à {city}</h2>
          <div class="faq-list">
            {faq.map((item, i) => (
              <details class="faq-item" open={i === 0}>
                <summary class="faq-q">{item.q}</summary>
                <p class="faq-a">{item.a}</p>
              </details>
            ))}
          </div>
        </div>

        <div class="nearby reveal">
          <h2>Zones voisines</h2>
          <p>Nous intervenons également dans les communes proches :</p>
          <div class="nearby-grid">
            {nearbyZones.map(z => (
              <a href={z.href} class="nearby-link">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
                Peintre à {z.name} →
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <Contact />
  </main>
</Layout>

<style>
  main { padding-top: 0; }
  .page-header { background: var(--bg-dark); padding: 9rem 0 4rem; }
  .breadcrumb { display: flex; align-items: center; gap: 0.5rem; font-size: 0.8rem; color: rgba(255,255,255,0.4); margin-bottom: 1.5rem; }
  .breadcrumb a { color: rgba(255,255,255,0.5); text-decoration: none; }
  .breadcrumb a:hover { color: var(--accent-light); }
  .eyebrow { color: var(--accent-light); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; margin-bottom: 0.75rem; }
  .page-header h1 { font-family: 'Playfair Display', serif; font-size: clamp(2.2rem, 5vw, 4rem); color: white; margin-bottom: 0.75rem; }
  .sub { color: rgba(255,255,255,0.5); font-size: 1rem; margin-bottom: 1.5rem; }
  .nap { display: flex; gap: 2rem; flex-wrap: wrap; font-size: 0.9rem; color: rgba(255,255,255,0.6); }
  .nap a { color: var(--accent-light); text-decoration: none; }
  .content-section { padding: 5rem 0; background: var(--bg); }
  .container { max-width: 1280px; margin: 0 auto; padding: 0 2rem; }
  .intro { max-width: 820px; margin-bottom: 4rem; }
  .intro h2 { font-family: 'Playfair Display', serif; font-size: clamp(1.5rem, 3vw, 2.25rem); color: var(--primary); margin-bottom: 1rem; }
  .intro p { color: var(--text-muted); line-height: 1.8; font-size: 1rem; margin-bottom: 1rem; }
  .services-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; margin-bottom: 4rem; }
  .service-card { background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 2rem; }
  .service-card h3 { font-family: 'Playfair Display', serif; font-size: 1.1rem; color: var(--primary); margin-bottom: 0.75rem; }
  .service-card p { color: var(--text-muted); font-size: 0.9rem; line-height: 1.7; }
  .neighborhoods-block { margin-bottom: 4rem; }
  .neighborhoods-block h2 { font-family: 'Playfair Display', serif; font-size: clamp(1.4rem, 2.5vw, 2rem); color: var(--primary); margin-bottom: 1.5rem; }
  .neighborhoods-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 0.75rem; }
  .neighborhood-item { display: flex; align-items: center; gap: 0.6rem; background: var(--card); border: 1px solid var(--border); border-radius: 8px; padding: 0.65rem 1rem; font-size: 0.9rem; color: var(--text); }
  .neighborhood-item svg { color: var(--accent); flex-shrink: 0; }
  .faq-block { margin-bottom: 4rem; }
  .faq-block h2 { font-family: 'Playfair Display', serif; font-size: clamp(1.4rem, 2.5vw, 2rem); color: var(--primary); margin-bottom: 1.5rem; }
  .faq-list { max-width: 760px; }
  .faq-item { border-bottom: 1px solid var(--border); }
  .faq-item:first-child { border-top: 1px solid var(--border); }
  .faq-q { list-style: none; padding: 1.25rem 0; font-weight: 600; color: var(--primary); font-size: 0.95rem; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .faq-q::after { content: '+'; color: var(--accent); font-size: 1.4rem; font-weight: 300; flex-shrink: 0; transition: transform 0.2s; }
  .faq-item[open] .faq-q::after { transform: rotate(45deg); }
  .faq-q::-webkit-details-marker { display: none; }
  .faq-a { color: var(--text-muted); font-size: 0.9rem; line-height: 1.75; padding-bottom: 1.25rem; }
  .nearby h2 { font-family: 'Playfair Display', serif; font-size: 1.4rem; color: var(--primary); margin-bottom: 0.5rem; }
  .nearby > p { color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1rem; }
  .nearby-grid { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .nearby-link { display: flex; align-items: center; gap: 0.5rem; background: var(--card); border: 1px solid var(--border); border-radius: 100px; padding: 0.5rem 1.1rem; text-decoration: none; color: var(--accent); font-size: 0.85rem; font-weight: 500; transition: border-color 0.2s, background 0.2s; }
  .nearby-link:hover { border-color: var(--accent); background: #FDF8F3; }
  .nearby-link svg { color: var(--accent); }
  @media (max-width: 768px) { .nap { gap: 1rem; } .services-grid { grid-template-columns: 1fr; } }
</style>
