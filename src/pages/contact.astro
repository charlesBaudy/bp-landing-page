---
import Layout from '../layouts/Layout.astro';
import Contact from '../components/Contact.astro';

---

<Layout 
  title="Contact | Baudy Peinture Toulon"
  description="Contactez Baudy Peinture à Toulon pour vos projets de peinture. Devis gratuit, conseil personnalisé et intervention rapide."
>
  <main>
    <div class="page-header">
      <div class="container">
        <p class="eyebrow">Parlons de votre projet</p>
        <h1>Contact</h1>
        <p class="sub">Pour tous vos projets de peinture à Toulon et environs</p>
      </div>
    </div>
    <Contact />
  </main>
</Layout>

<style>
  main { padding-top: 0; }

  .page-header {
    background: var(--bg-dark);
    padding: 10rem 0 5rem;
  }
  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
  }
  .eyebrow {
    color: var(--accent-light);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }
  .page-header h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.5rem, 6vw, 5rem);
    color: white;
    margin-bottom: 0.75rem;
  }
  .sub { color: rgba(255,255,255,0.5); font-size: 1rem; }
</style>