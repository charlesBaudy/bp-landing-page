---
import Layout from '../layouts/Layout.astro';
import Contact from '../components/Contact.astro';

---

<Layout 
  title="Contact | Baudy Peinture Toulon"
  description="Contactez Baudy Peinture à Toulon pour vos projets de peinture. Devis gratuit, conseil personnalisé et intervention rapide."
>
  <main>
    <div class="page-header">
      <div class="container">
        <p class="eyebrow">Parlons de votre projet</p>
        <h1>Contact</h1>
        <p class="sub">Pour tous vos projets de peinture à Toulon et environs</p>
      </div>
    </div>
    <Contact />

    <section class="map-section">
      <div class="container">
        <p class="eyebrow">Zone d'intervention</p>
        <h2>Nous intervenons à Toulon et dans le Var</h2>
      </div>
      <div class="map-wrap">
        <iframe
          title="Baudy Peinture — Zone d'intervention Toulon, Var"
          src="https://maps.google.com/maps?q=Toulon,+Var,+France&output=embed&hl=fr&z=11"
          width="100%"
          height="420"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </section>
  </main>
</Layout>

<style>
  main { padding-top: 0; }

  .page-header {
    background: var(--bg-dark);
    padding: 10rem 0 5rem;
  }
  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
  }
  .eyebrow {
    color: var(--accent-light);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }
  .page-header h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.5rem, 6vw, 5rem);
    color: white;
    margin-bottom: 0.75rem;
  }
  .sub { color: rgba(255,255,255,0.5); font-size: 1rem; }

  .map-section {
    background: var(--bg);
  }
  .map-section .container {
    padding-top: 5rem;
    padding-bottom: 2rem;
  }
  .map-section .eyebrow {
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }
  .map-section h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    color: var(--primary);
    margin-bottom: 0;
  }
  .map-wrap {
    width: 100%;
    overflow: hidden;
  }
  .map-wrap iframe {
    display: block;
    width: 100%;
    height: 420px;
  }

  @media (max-width: 768px) {
    .map-section .container { padding-top: 3rem; padding-bottom: 1.25rem; }
    .map-wrap iframe { height: 300px; }
  }
</style>