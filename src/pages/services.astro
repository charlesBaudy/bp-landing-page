---
import Layout from '../layouts/Layout.astro';
import Services from '../components/Services.astro';

---

<Layout 
  title="Services de Peinture Professionnelle | Baudy Peinture Toulon"
  description="Découvrez nos services de peinture professionnelle à Toulon : peinture intérieure, extérieure, ravalement de façade et rénovation. Devis gratuit."
>
  <main>
    <div class="page-header">
      <div class="container">
        <p class="eyebrow">Expertises</p>
        <h1>Nos Services</h1>
        <p class="sub">Des solutions professionnelles adaptées à vos besoins</p>
      </div>
    </div>
    <Services />
    <section class="why">
      <div class="container">
        <p class="eyebrow reveal">Nos engagements</p>
        <h2 class="reveal">Pourquoi choisir<br>Baudy Peinture ?</h2>
        <div class="benefits-grid">
          <div class="benefit reveal reveal-delay-1">
            <span class="benefit-num">01</span>
            <h3>Expertise Professionnelle</h3>
            <p>Plus de 15 ans d'expérience dans le domaine de la peinture en bâtiment à Toulon et ses environs.</p>
          </div>
          <div class="benefit reveal reveal-delay-2">
            <span class="benefit-num">02</span>
            <h3>Qualité Garantie</h3>
            <p>Utilisation exclusive de produits professionnels — garantie décennale sur tous les travaux réalisés.</p>
          </div>
          <div class="benefit reveal reveal-delay-3">
            <span class="benefit-num">03</span>
            <h3>Service Personnalisé</h3>
            <p>Accompagnement et conseils personnalisés à chaque étape, du devis à la réception du chantier.</p>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  main { padding-top: 0; }

  .page-header {
    background: var(--bg-dark);
    padding: 10rem 0 5rem;
  }
  .eyebrow {
    color: var(--accent-light);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }
  .page-header h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.5rem, 6vw, 5rem);
    color: white;
    margin-bottom: 0.75rem;
  }
  .sub { color: rgba(255,255,255,0.5); font-size: 1rem; }

  .why {
    padding: 7rem 0;
    background: var(--bg-dark);
  }
  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
  }
  h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 3.5vw, 3rem);
    color: white;
    margin-bottom: 3.5rem;
    line-height: 1.2;
  }
  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 2rem;
  }
  .benefit {
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 12px;
    padding: 2rem;
    background: rgba(255,255,255,0.03);
  }
  .benefit-num {
    display: block;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.15em;
    margin-bottom: 1rem;
  }
  .benefit h3 {
    font-family: 'Playfair Display', serif;
    color: white;
    font-size: 1.15rem;
    margin-bottom: 0.75rem;
  }
  .benefit p {
    color: rgba(255,255,255,0.45);
    font-size: 0.9rem;
    line-height: 1.65;
  }
</style>