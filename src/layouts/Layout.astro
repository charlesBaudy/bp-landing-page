---
import Navigation from '../components/Navigation.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage = '/og-image.jpg' } = Astro.props;
const siteUrl = 'https://www.baudypeinture.fr';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Géolocalisation locale -->
    <meta name="geo.region" content="FR-83" />
    <meta name="geo.placename" content="Toulon, Var" />
    <meta name="geo.position" content="43.1242;5.9280" />
    <meta name="ICBM" content="43.1242, 5.9280" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Baudy Peinture" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

    <!-- Schema.org LocalBusiness -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": ["LocalBusiness", "PaintingContractor"],
      "name": "Baudy Peinture",
      "url": "https://www.baudypeinture.fr",
      "logo": "https://www.baudypeinture.fr/favicon.svg",
      "image": "https://www.baudypeinture.fr/og-image.jpg",
      "telephone": "+33620156410",
      "email": "polobaudy@icloud.com",
      "hasMap": "https://maps.google.com/?q=Baudy+Peinture+Toulon",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Toulon",
        "addressRegion": "Provence-Alpes-Côte d'Azur",
        "postalCode": "83000",
        "addressCountry": "FR"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 43.1242,
        "longitude": 5.9280
      },
      "areaServed": [
        { "@type": "City", "name": "Toulon", "sameAs": "https://www.wikidata.org/wiki/Q42646" },
        { "@type": "City", "name": "La Seyne-sur-Mer", "sameAs": "https://www.wikidata.org/wiki/Q168761" },
        { "@type": "City", "name": "Six-Fours-les-Plages", "sameAs": "https://www.wikidata.org/wiki/Q216426" },
        { "@type": "City", "name": "Hyères", "sameAs": "https://www.wikidata.org/wiki/Q45761" },
        { "@type": "City", "name": "La Valette-du-Var", "sameAs": "https://www.wikidata.org/wiki/Q209358" }
      ],
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
          "opens": "08:00",
          "closes": "18:00"
        },
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": "Saturday",
          "opens": "09:00",
          "closes": "12:00"
        }
      ],
      "priceRange": "€€",
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "5",
        "reviewCount": "4",
        "bestRating": "5",
        "worstRating": "1"
      },
      "description": "Artisan peintre professionnel à Toulon. Peinture intérieure, extérieure et rénovation pour particuliers et professionnels dans le Var (83).",
      "knowsAbout": [
        "Peinture intérieure",
        "Peinture extérieure",
        "Ravalement de façade",
        "Pose de papier peint",
        "Rénovation appartement",
        "Enduit décoratif"
      ],
      "paymentAccepted": "Espèces, Virement bancaire, Chèque",
      "currenciesAccepted": "EUR"
    }
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body>
    <Navigation />
    <slot />

    <!-- Sticky mobile CTA bar -->
    <div class="mobile-cta-bar" aria-label="Contact rapide">
      <a href="tel:+33620156410" class="mobile-cta-call">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81a19.79 19.79 0 01-3.07-8.72A2 2 0 012 .18h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.91 7.91a16 16 0 006.16 6.16l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 14.92l-.08 2z"/></svg>
        Appeler
      </a>
      <a href="/contact" class="mobile-cta-devis">Devis gratuit</a>
    </div>

    <footer>
      <div class="container">
        <div class="footer-inner">
          <div class="footer-brand">
            <span class="footer-mark">BP</span>
            <span class="footer-name">Baudy Peinture</span>
          </div>
          <div class="footer-links">
            <a href="/services">Services</a>
            <a href="/realisations">Réalisations</a>
            <a href="/contact">Contact</a>
          </div>
          <p class="footer-copy">&copy; 2025 Baudy Peinture · Toulon, Var (83)</p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg:        #F5F2EC;
    --bg-dark:   #12110F;
    --primary:   #12110F;
    --accent:    #B5773A;
    --accent-light: #D4973F;
    --text:      #3A3830;
    --text-muted: #89877F;
    --border:    #E2DDD4;
    --card:      #FFFFFF;
  }

  *, *::before, *::after { box-sizing: border-box; }

  html {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    background: var(--bg);
    color: var(--text);
    scroll-behavior: smooth;
    scroll-padding-top: 80px;
    font-size: 16px;
    -webkit-font-smoothing: antialiased;
  }

  body { margin: 0; padding: 0; line-height: 1.65; overflow-x: hidden; }

  h1, h2, h3, h4 {
    font-family: 'Playfair Display', Georgia, serif;
    line-height: 1.15;
    margin: 0;
    color: var(--primary);
  }

  p { margin: 0; }

  img { display: block; max-width: 100%; }

  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* scroll-reveal utility */
  .reveal {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }
  .reveal-delay-1 { transition-delay: 0.1s; }
  .reveal-delay-2 { transition-delay: 0.2s; }
  .reveal-delay-3 { transition-delay: 0.3s; }
  .reveal-delay-4 { transition-delay: 0.4s; }

  /* page-header for inner pages */
  .page-header {
    background: var(--bg-dark);
    color: white;
    padding: 10rem 2rem 6rem;
    margin-top: 0;
  }
  .page-header h1 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(2.5rem, 6vw, 5rem);
    color: white;
    margin-bottom: 1rem;
  }
  .page-header p {
    color: rgba(255,255,255,0.6);
    font-size: 1.15rem;
  }

  footer {
    background: var(--bg-dark);
    border-top: 1px solid rgba(255,255,255,0.07);
    padding: 2.5rem 0;
  }
  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
  }
  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .footer-mark {
    width: 32px; height: 32px;
    background: var(--accent);
    border-radius: 5px;
    color: white;
    font-family: 'Playfair Display', serif;
    font-weight: 700;
    font-size: 0.85rem;
    display: flex; align-items: center; justify-content: center;
  }
  .footer-name {
    color: rgba(255,255,255,0.7);
    font-size: 0.9rem;
    font-weight: 500;
  }
  .footer-links {
    display: flex;
    gap: 2rem;
  }
  .footer-links a {
    color: rgba(255,255,255,0.45);
    text-decoration: none;
    font-size: 0.85rem;
    transition: color 0.2s;
  }
  .footer-links a:hover { color: rgba(255,255,255,0.8); }
  .footer-copy {
    color: rgba(255,255,255,0.3);
    font-size: 0.8rem;
  }

  /* ── Sticky mobile CTA bar ── */
  .mobile-cta-bar {
    display: none;
  }

  /* ── Mobile global ── */
  @media (max-width: 768px) {
    .container { padding: 0 1.25rem; }
    .footer-inner { flex-direction: column; align-items: flex-start; }
    .page-header { padding: 6rem 1.25rem 3rem; }
    .page-header h1 { font-size: clamp(1.9rem, 8vw, 3rem); }
    /* prevent iOS tap highlight */
    a, button { -webkit-tap-highlight-color: transparent; }
    /* prevent iOS double-tap zoom on buttons/links */
    a, button { touch-action: manipulation; }

    /* sticky CTA bar */
    .mobile-cta-bar {
      display: flex;
      position: fixed;
      bottom: 0; left: 0; right: 0;
      z-index: 998;
      background: var(--bg-dark);
      border-top: 1px solid rgba(255,255,255,0.1);
      padding: 0.75rem 1rem;
      padding-bottom: calc(0.75rem + env(safe-area-inset-bottom));
      gap: 0.75rem;
    }
    .mobile-cta-call {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      flex: 1;
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,255,255,0.15);
      border-radius: 10px;
      color: white;
      text-decoration: none;
      font-size: 0.9rem;
      font-weight: 600;
      min-height: 48px;
      transition: background 0.2s;
    }
    .mobile-cta-call:active { background: rgba(255,255,255,0.15); }
    .mobile-cta-devis {
      display: flex;
      align-items: center;
      justify-content: center;
      flex: 1.4;
      background: var(--accent);
      border-radius: 10px;
      color: white;
      text-decoration: none;
      font-size: 0.9rem;
      font-weight: 600;
      min-height: 48px;
      transition: background 0.2s;
    }
    .mobile-cta-devis:active { background: var(--accent-light); }

    /* push footer above the sticky bar */
    footer { padding-bottom: calc(2.5rem + 80px); }
  }
</style>

<script is:inline>
  // Scroll reveal
  const observer = new IntersectionObserver(
    entries => entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); }),
    { threshold: 0.12 }
  );
  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

  // Re-run after page fully loaded (catches late-rendered elements)
  window.addEventListener('load', () => {
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
  });
</script>