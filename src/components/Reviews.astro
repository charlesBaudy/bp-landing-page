---
const reviews = [
  {
    name: "Jean-Marc Salsa",
    location: "Bandol · Marseille",
    rating: 5,
    text: "Cela fait plusieurs années que je fais confiance à l'entreprise Baudy pour de nombreux travaux sur Bandol et Marseille. Travail rapide, soigné, indépendant (pas besoin de toujours être présent), et dans les temps. Je recommande à 200%.",
    date: "2024-01",
  },
  {
    name: "Christine Ziegler Guiony",
    location: "",
    rating: 5,
    text: "Très bon peintre qui est intervenu dans mon magasin et dans mon domicile, à plusieurs reprises et depuis de nombreuses années.",
    date: "2024-01",
  },
  {
    name: "Karine",
    location: "",
    rating: 5,
    text: "Personne très compétente, sérieuse et bon travail soigné. Il m'a fait tout mon appartement peinture, murs et carrelage et je suis contente. Je recommande 🔥",
    date: "2024-01",
  },
  {
    name: "Maxime Delarue",
    location: "",
    rating: 5,
    text: "Très satisfait du travail réalisé ! Merci encore !",
    date: "2024-07",
  },
];

---

<section class="reviews">
  <div class="container">
    <div class="reviews-header reveal">
      <div>
        <p class="eyebrow">Témoignages</p>
        <h2>Ce que disent nos clients</h2>
      </div>
      <div class="rating-summary">
        <div class="rating-score">5,0</div>
        <div class="rating-meta">
          <div class="stars" aria-label="5 sur 5 étoiles">
            {[1,2,3,4,5].map(() => (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            ))}
          </div>
          <span>Avis Google</span>
        </div>
      </div>
    </div>

    <div class="reviews-grid">
      {reviews.map((r, i) => (
        <blockquote class={`review-card reveal reveal-delay-${(i % 4) + 1}`}>
          <div class="review-top">
            <div class="review-stars" aria-label={`${r.rating} sur 5 étoiles`}>
              {Array.from({ length: r.rating }).map(() => (
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              ))}
            </div>
            <svg class="google-icon" width="18" height="18" viewBox="0 0 24 24" aria-label="Google"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
          </div>
          <p class="review-text">"{r.text}"</p>
          <div class="review-footer">
            <span class="review-name">{r.name}</span>
            {r.location && <span class="review-loc">{r.location}</span>}
          </div>
        </blockquote>
      ))}
    </div>
  </div>
</section>

<style>
  .reviews {
    padding: 7rem 0;
    background: var(--bg);
  }
  .container { max-width: 1280px; margin: 0 auto; padding: 0 2rem; }
  .reviews-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-bottom: 3rem;
  }
  .eyebrow {
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }
  h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    color: var(--primary);
  }
  .rating-summary {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 1rem 1.5rem;
    flex-shrink: 0;
  }
  .rating-score {
    font-family: 'Playfair Display', serif;
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--primary);
    line-height: 1;
  }
  .rating-meta { display: flex; flex-direction: column; gap: 0.3rem; }
  .stars { display: flex; gap: 2px; color: #F59E0B; }
  .rating-meta span { font-size: 0.8rem; color: var(--text-muted); }

  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.25rem;
  }
  .review-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 1.75rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: box-shadow 0.25s, transform 0.25s;
  }
  .review-card:hover {
    box-shadow: 0 6px 24px rgba(0,0,0,0.07);
    transform: translateY(-3px);
  }
  .review-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .review-stars { display: flex; gap: 2px; color: #F59E0B; }
  .google-icon { flex-shrink: 0; opacity: 0.8; }
  .review-text {
    font-style: italic;
    color: var(--text-muted);
    line-height: 1.7;
    font-size: 0.95rem;
    flex: 1;
  }
  .review-footer {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
  }
  .review-name { font-weight: 600; color: var(--primary); font-size: 0.9rem; }
  .review-loc { color: var(--text-muted); font-size: 0.8rem; }

  @media (max-width: 768px) {
    .reviews { padding: 4rem 0; }
    .reviews-header { flex-direction: column; align-items: flex-start; margin-bottom: 2rem; }
    .rating-summary { width: 100%; }
    .reviews-grid { grid-template-columns: 1fr; }
    .review-card:hover { transform: none; box-shadow: none; }
  }
</style>
