---
const stats = [
  { num: "15+", label: "ans d'expérience" },
  { num: "500+", label: "chantiers réalisés" },
  { num: "5", label: "villes d'intervention" },
];

const features = [
  { title: "Devis gratuit", desc: "Estimation rapide et sans engagement, sous 48h" },
  { title: "Garantie décennale", desc: "Tous nos travaux sont couverts et assurés" },
  { title: "Produits pros", desc: "Marques professionnelles pour un résultat durable" },
  { title: "Ponctualité", desc: "Respect des délais et des chantiers clients" },
];
---

<section id="about" class="about">
  <div class="container">

    <div class="about-header reveal">
      <p class="eyebrow">Notre histoire</p>
      <h2>L'artisanat au service<br>de votre intérieur</h2>
    </div>

    <div class="about-body">
      <div class="about-text reveal reveal-delay-1">
        <p class="lead">
          Artisan peintre qualifié basé à Toulon, je transforme vos espaces avec soin et précision depuis plus de 15 ans.
        </p>
        <p class="body-text">
          Spécialisé dans la peinture intérieure et extérieure, chaque chantier est traité avec la même exigence : une préparation rigoureuse des surfaces, des matériaux professionnels et des finitions impeccables qui durent dans le temps.
        </p>
        <a href="/contact" class="cta-link">Demander un devis →</a>
      </div>

      <div class="features-grid">
        {features.map((f, i) => (
          <div class={`feature reveal reveal-delay-${i + 1}`}>
            <div class="feature-dot"></div>
            <div>
              <strong>{f.title}</strong>
              <p>{f.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="stats-row">
      {stats.map((s, i) => (
        <div class={`stat-block reveal reveal-delay-${i + 1}`}>
          <span class="stat-num">{s.num}</span>
          <span class="stat-label">{s.label}</span>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .about {
    padding: 7rem 0;
    background: var(--bg-dark);
    color: white;
  }
  .about-header {
    max-width: 640px;
    margin-bottom: 4rem;
  }
  .eyebrow {
    color: var(--accent-light);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }
  .about-header h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 4vw, 3.25rem);
    color: white;
    line-height: 1.2;
  }
  .about-body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    margin-bottom: 5rem;
  }
  .lead {
    font-size: 1.2rem;
    color: rgba(255,255,255,0.85);
    font-weight: 400;
    line-height: 1.7;
    margin-bottom: 1.25rem;
  }
  .body-text {
    color: rgba(255,255,255,0.5);
    line-height: 1.75;
    font-size: 0.95rem;
    margin-bottom: 2rem;
  }
  .cta-link {
    color: var(--accent-light);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    transition: opacity 0.2s;
  }
  .cta-link:hover { opacity: 0.75; }

  .features-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.75rem;
    align-content: start;
  }
  .feature {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
  }
  .feature-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
    margin-top: 0.4rem;
  }
  .feature strong {
    display: block;
    color: white;
    font-size: 0.9rem;
    margin-bottom: 0.25rem;
  }
  .feature p {
    color: rgba(255,255,255,0.45);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  /* stats */
  .stats-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid rgba(255,255,255,0.1);
    padding-top: 3.5rem;
    gap: 2rem;
  }
  .stat-block {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .stat-num {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.5rem, 4vw, 4rem);
    color: white;
    line-height: 1;
  }
  .stat-label {
    color: rgba(255,255,255,0.45);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .about-body { grid-template-columns: 1fr; gap: 3rem; }
    .features-grid { grid-template-columns: 1fr; }
    .stats-row { grid-template-columns: 1fr; }
  }
</style>
