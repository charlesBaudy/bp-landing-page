---
import { Image } from 'astro:assets';
import imgAppartMourillon from '../assets/bp-img/peinture_appartement_mourillon.JPG';
import imgChambreToulon from '../assets/bp-img/peinture_chambre_toulon.jpg';
import imgChambreToulon2 from '../assets/bp-img/peinture_chambre_toulon_2.jpg';
import imgSalonMourillon from '../assets/bp-img/renovation_salon_mourillon.JPG';
import imgEscalierAvant from '../assets/bp-img/escalier_avant.jpg';
import imgEscalierApres from '../assets/bp-img/escalier_apres.jpg';
import imgCarrelage from '../assets/bp-img/carrelage_salle_de_bain.jpg';
import imgSdbSanary from '../assets/bp-img/salle_de_bain_sanary.JPG';
import imgSdbToulon from '../assets/bp-img/salle_de_bain_toulon.JPG';
import imgFenetreAvant from '../assets/bp-img/peinture_fenetre_toulon_avant.jpg';
import imgFenetreApres from '../assets/bp-img/peinture_fenetre_toulon.jpg';
import imgPlafondBandol from '../assets/bp-img/plafond_bandol.jpg';

const projects = [
	{
		title: "Peinture Appartement Mourillon",
		description: "Rénovation complète de la peinture d'un appartement",
		image: imgAppartMourillon,
	},
	{
		title: "Rénovation Salon Mourillon",
		description: "Transformation complète d'un salon à Mourillon, Toulon",
		image: imgSalonMourillon,
	},
	{
		title: "Peinture Chambre Toulon",
		description: "Peinture intérieure chambre avec finitions soignées",
		image: imgChambreToulon,
	},
	{
		title: "Peinture Chambre Toulon",
		description: "Rénovation complète d'une chambre, résultat impeccable",
		image: imgChambreToulon2,
	},
	{
		title: "Plafond Bandol",
		description: "Peinture de plafond avec traitement préalable des surfaces",
		image: imgPlafondBandol,
	},
	{
		title: "Pose Carrelage Salle de Bain",
		description: "Carrelage et finitions pour une salle de bain rénovée",
		image: imgCarrelage,
	},
	{
		title: "Salle de Bain Sanary-sur-Mer",
		description: "Rénovation complète salle de bain à Sanary-sur-Mer",
		image: imgSdbSanary,
	},
	{
		title: "Salle de Bain Toulon",
		description: "Rénovation salle de bain avec pose carrelage et peinture",
		image: imgSdbToulon,
	},
];

const avantApres = [
	{
		title: "Escalier — Avant / Après",
		avant: imgEscalierAvant,
		apres: imgEscalierApres,
	},
	{
		title: "Fenêtre Toulon — Avant / Après",
		avant: imgFenetreAvant,
		apres: imgFenetreApres,
	},
];
---

<section id="portfolio" class="portfolio-section">
	<div class="container">
		<h2>Réalisations</h2>
		<div class="portfolio-grid">
			{projects.map(project => (
				<div class="portfolio-item">
					<Image src={project.image} alt={project.title} width={800} height={600} loading="lazy" />
					<div class="portfolio-info">
						<h3>{project.title}</h3>
						<p>{project.description}</p>
					</div>
				</div>
			))}
		</div>

		<h3 class="avant-apres-title">Avant / Après</h3>
		<div class="avant-apres-grid">
			{avantApres.map(item => (
				<div class="avant-apres-card">
					<p class="aa-label">{item.title}</p>
					<div class="aa-images">
						<div class="aa-col">
							<span class="aa-tag">Avant</span>
							<Image src={item.avant} alt={`${item.title} - avant`} width={600} height={450} loading="lazy" />
						</div>
						<div class="aa-col">
							<span class="aa-tag apres">Après</span>
							<Image src={item.apres} alt={`${item.title} - après`} width={600} height={450} loading="lazy" />
						</div>
					</div>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.portfolio-section {
		padding: 4rem 0;
		background: rgb(var(--background));
	}
	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1rem;
	}
	h2 {
		text-align: center;
		color: rgb(var(--primary));
		margin-bottom: 3rem;
		font-size: 2.5rem;
		font-weight: 700;
		position: relative;
	}
	h2::after {
		content: "";
		position: absolute;
		bottom: -0.5rem;
		left: 50%;
		transform: translateX(-50%);
		width: 100px;
		height: 4px;
		background: rgb(var(--accent));
		border-radius: 2px;
	}
	.portfolio-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 2rem;
		margin-bottom: 4rem;
	}
	.portfolio-item {
		border-radius: 8px;
		overflow: hidden;
		box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
		background: white;
	}
	.portfolio-item img {
		width: 100%;
		height: 250px;
		object-fit: cover;
		display: block;
	}
	.portfolio-info {
		padding: 1rem;
	}
	h3 {
		margin: 0 0 0.5rem 0;
		color: rgb(var(--primary));
		font-size: 1.1rem;
	}
	p {
		margin: 0;
		font-size: 0.9rem;
		color: rgb(var(--text));
		line-height: 1.4;
	}
	.avant-apres-title {
		text-align: center;
		color: rgb(var(--primary));
		font-size: 1.8rem;
		font-weight: 700;
		margin-bottom: 2rem;
	}
	.avant-apres-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(500px, 1fr));
		gap: 2rem;
	}
	.avant-apres-card {
		border-radius: 8px;
		overflow: hidden;
		box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
		background: white;
		padding: 1rem;
	}
	.aa-label {
		font-size: 1rem;
		font-weight: 600;
		color: rgb(var(--primary));
		margin: 0 0 0.75rem 0;
		text-align: center;
	}
	.aa-images {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.5rem;
	}
	.aa-col {
		position: relative;
	}
	.aa-col img {
		width: 100%;
		height: 200px;
		object-fit: cover;
		border-radius: 4px;
		display: block;
	}
	.aa-tag {
		display: inline-block;
		background: rgba(0,0,0,0.55);
		color: white;
		font-size: 0.75rem;
		font-weight: 600;
		padding: 0.2rem 0.5rem;
		border-radius: 4px;
		margin-bottom: 0.3rem;
	}
	.aa-tag.apres {
		background: rgb(var(--accent));
	}
	@media (max-width: 768px) {
		.avant-apres-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
