---
import { Image } from 'astro:assets';
import imgAppartMourillon from '../assets/bp-img/peinture_appartement_mourillon.JPG';
import imgChambreToulon from '../assets/bp-img/peinture_chambre_toulon.jpg';
import imgChambreToulon2 from '../assets/bp-img/peinture_chambre_toulon_2.jpg';
import imgSalonMourillon from '../assets/bp-img/renovation_salon_mourillon.JPG';
import imgEscalierAvant from '../assets/bp-img/escalier_avant.jpg';
import imgEscalierApres from '../assets/bp-img/escalier_apres.jpg';
import imgCarrelage from '../assets/bp-img/carrelage_salle_de_bain.jpg';
import imgSdbSanary from '../assets/bp-img/salle_de_bain_sanary.JPG';
import imgSdbToulon from '../assets/bp-img/salle_de_bain_toulon.JPG';
import imgFenetreAvant from '../assets/bp-img/peinture_fenetre_toulon_avant.jpg';
import imgFenetreApres from '../assets/bp-img/peinture_fenetre_toulon.jpg';
import imgPlafondBandol from '../assets/bp-img/plafond_bandol.jpg';

const projects = [
  { title: "Appartement Mourillon", loc: "Toulon", image: imgAppartMourillon, size: "large" },
  { title: "Rénovation Salon", loc: "Mourillon", image: imgSalonMourillon, size: "small" },
  { title: "Chambre Principale", loc: "Toulon", image: imgChambreToulon, size: "small" },
  { title: "Chambre Enfant", loc: "Toulon", image: imgChambreToulon2, size: "small" },
  { title: "Plafond Décoratif", loc: "Bandol", image: imgPlafondBandol, size: "small" },
  { title: "Salle de Bain", loc: "Sanary-sur-Mer", image: imgSdbSanary, size: "large" },
  { title: "Salle de Bain", loc: "Toulon", image: imgSdbToulon, size: "small" },
  { title: "Pose Carrelage", loc: "Toulon", image: imgCarrelage, size: "small" },
];

const avantApres = [
  { title: "Escalier", avant: imgEscalierAvant, apres: imgEscalierApres },
  { title: "Fenêtre", avant: imgFenetreAvant, apres: imgFenetreApres },
];
---

<section id="portfolio" class="portfolio">
  <div class="container">

    <div class="portfolio-header reveal">
      <div>
        <p class="eyebrow">Nos travaux</p>
        <h2>Réalisations</h2>
      </div>
      <a href="/realisations" class="see-all">Voir tout →</a>
    </div>

    <div class="grid">
      {projects.map((p, i) => (
        <figure class={`item ${p.size} reveal reveal-delay-${(i % 4) + 1}`}>
          <Image src={p.image} alt={p.title} width={900} height={700} loading="lazy" />
          <figcaption>
            <span class="item-title">{p.title}</span>
            <span class="item-loc">{p.loc}</span>
          </figcaption>
        </figure>
      ))}
    </div>

    <div class="aa-section reveal">
      <h3 class="aa-heading">Avant / Après</h3>
      <p class="aa-hint">← Glissez pour comparer →</p>
      <div class="aa-grid">
        {avantApres.map(item => (
          <div class="aa-card">
            <p class="aa-title">{item.title}</p>
            <div class="ba-slider">
              <Image class="ba-img ba-before" src={item.avant} alt={`${item.title} avant`} width={700} height={525} loading="lazy" />
              <Image class="ba-img ba-after" src={item.apres} alt={`${item.title} après`} width={700} height={525} loading="lazy" />
              <div class="ba-handle" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
              </div>
              <span class="ba-label ba-label-avant">Avant</span>
              <span class="ba-label ba-label-apres">Après</span>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<style>
  .portfolio {
    padding: 7rem 0;
    background: var(--bg);
  }
  .portfolio-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 3rem;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .eyebrow {
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }
  h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 4vw, 3.25rem);
    color: var(--primary);
  }
  .see-all {
    color: var(--accent);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    white-space: nowrap;
    transition: opacity 0.2s;
  }
  .see-all:hover { opacity: 0.7; }

  /* masonry-like grid */
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: auto;
    gap: 1rem;
    margin-bottom: 5rem;
  }
  .item {
    position: relative;
    margin: 0;
    border-radius: 10px;
    overflow: hidden;
    cursor: pointer;
    background: #E0DBD3;
  }
  .item.large { grid-column: span 2; }

  .item img {
    width: 100%;
    height: 320px;
    object-fit: cover;
    transition: transform 0.6s ease;
    display: block;
  }
  .item.large img { height: 420px; }
  .item:hover img { transform: scale(1.05); }

  figcaption {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(18,17,15,0.75) 0%, transparent 55%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.25rem;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .item:hover figcaption { opacity: 1; }
  .item-title {
    color: white;
    font-family: 'Playfair Display', serif;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.2;
  }
  .item-loc {
    color: rgba(255,255,255,0.6);
    font-size: 0.75rem;
    margin-top: 0.2rem;
  }

  /* avant/après slider */
  .aa-section { margin-top: 2rem; }
  .aa-heading {
    font-family: 'Playfair Display', serif;
    font-size: 1.75rem;
    color: var(--primary);
    margin-bottom: 1.75rem;
  }
  .aa-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 1.5rem;
  }
  .aa-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    padding: 1.25rem;
  }
  .aa-title {
    font-weight: 600;
    color: var(--primary);
    font-size: 0.9rem;
    margin-bottom: 0.9rem;
  }

  /* slider */
  .aa-hint {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
    margin-top: -0.5rem;
  }
  .ba-slider {
    position: relative;
    overflow: hidden;
    border-radius: 8px;
    cursor: ew-resize;
    user-select: none;
    touch-action: none;
    aspect-ratio: 4/3;
    --pct: 50%;
  }
  .ba-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
  }
  /* before: always visible underneath */
  .ba-before { z-index: 0; }
  /* after: on top, clipped to show only the RIGHT portion (from pct to 100%) */
  .ba-after {
    z-index: 1;
    clip-path: inset(0 0 0 var(--pct));
  }
  .ba-handle {
    position: absolute;
    top: 0; bottom: 0;
    left: var(--pct);
    transform: translateX(-50%);
    width: 3px;
    background: white;
    box-shadow: 0 0 8px rgba(0,0,0,0.2);
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }
  .ba-handle::before {
    content: '';
    position: absolute;
    width: 40px; height: 40px;
    border-radius: 50%;
    background: white;
    box-shadow: 0 2px 12px rgba(0,0,0,0.25);
  }
  .ba-handle svg {
    position: relative;
    z-index: 1;
    color: var(--primary);
  }
  .ba-label {
    position: absolute;
    top: 0.6rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    color: white;
    pointer-events: none;
    z-index: 3;
  }
  .ba-label-avant {
    left: 0.6rem;
    background: rgba(18,17,15,0.65);
  }
  .ba-label-apres {
    right: 0.6rem;
    background: var(--accent);
  }

  @media (max-width: 900px) {
    .portfolio { padding: 4rem 0; }
    .grid { grid-template-columns: repeat(2, 1fr); }
    .item.large { grid-column: span 2; }
    .item img { height: 220px; }
    .item.large img { height: 280px; }
    .aa-section { margin-top: 1rem; }
  }
  @media (max-width: 580px) {
    .grid { grid-template-columns: 1fr; gap: 0.75rem; }
    .item.large { grid-column: span 1; }
    .item img, .item.large img { height: 220px; }
    .aa-card { padding: 1rem; }
    figcaption { opacity: 1; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.ba-slider').forEach(slider => {
    let dragging = false;

    function setPos(clientX: number) {
      const rect = slider.getBoundingClientRect();
      const pct = Math.min(Math.max(((clientX - rect.left) / rect.width) * 100, 3), 97);
      slider.style.setProperty('--pct', pct + '%');
    }

    slider.addEventListener('mousedown', e => { dragging = true; setPos(e.clientX); e.preventDefault(); });
    slider.addEventListener('touchstart', e => { dragging = true; setPos(e.touches[0].clientX); }, { passive: true });

    window.addEventListener('mousemove', e => { if (dragging) setPos(e.clientX); });
    window.addEventListener('touchmove', e => {
      if (dragging) { setPos(e.touches[0].clientX); e.preventDefault(); }
    }, { passive: false });

    window.addEventListener('mouseup', () => { dragging = false; });
    window.addEventListener('touchend', () => { dragging = false; });
  });
</script>
