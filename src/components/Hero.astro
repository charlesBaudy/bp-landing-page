---
import { Image } from 'astro:assets';
import heroImg from '../assets/bp-img/renovation_salon_mourillon.JPG';

interface Props {
  title: string;
  subtitle: string;
}
const { title, subtitle } = Astro.props;
---

<section class="hero">
  <div class="hero-bg">
    <Image
      src={heroImg}
      alt="Rénovation salon Mourillon par Baudy Peinture"
      width={1920}
      height={1080}
      loading="eager"
      class="hero-img"
    />
    <div class="hero-overlay"></div>
  </div>

  <div class="hero-content">
    <p class="hero-eyebrow">Artisan · Toulon · Var</p>
    <h1 class="hero-title">
      <span class="line">Peintre</span>
      <span class="line accent">en Bâtiment</span>
      <span class="line">à Toulon</span>
    </h1>
    <p class="hero-sub">{subtitle}</p>
    <div class="hero-actions">
      <a href="/contact" class="btn-primary">Devis gratuit</a>
      <a href="#portfolio" class="btn-ghost">Voir les réalisations</a>
    </div>
    <div class="trust-badges">
      <div class="badge">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        Garantie décennale
      </div>
      <div class="badge">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        Assurance RC Pro
      </div>
      <div class="badge">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        Devis sous 48h
      </div>
      <div class="badge">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        5/5 · Avis Google
      </div>
    </div>
  </div>

  <div class="hero-stats">
    <div class="stat">
      <span class="stat-num">15+</span>
      <span class="stat-label">ans d'expérience</span>
    </div>
    <div class="stat-divider"></div>
    <div class="stat">
      <span class="stat-num">500+</span>
      <span class="stat-label">chantiers réalisés</span>
    </div>
    <div class="stat-divider"></div>
    <div class="stat">
      <span class="stat-num">5</span>
      <span class="stat-label">villes d'intervention</span>
    </div>
    <div class="stat-divider"></div>
    <div class="stat">
      <span class="stat-num">100%</span>
      <span class="stat-label">devis gratuits</span>
    </div>
  </div>

  <div class="scroll-hint" aria-hidden="true">
    <span></span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
  }

  /* background */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1.04);
    animation: subtle-zoom 8s ease-out forwards;
  }
  @keyframes subtle-zoom {
    to { transform: scale(1); }
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      160deg,
      rgba(18, 17, 15, 0.75) 0%,
      rgba(18, 17, 15, 0.45) 60%,
      rgba(18, 17, 15, 0.65) 100%
    );
  }

  /* content */
  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 1280px;
    margin: 0 auto;
    padding: 6rem 2rem 2rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .hero-eyebrow {
    color: var(--accent-light);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    opacity: 0;
    animation: fade-up 0.8s 0.2s ease forwards;
  }
  .hero-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(3.5rem, 8vw, 7.5rem);
    font-weight: 700;
    color: white;
    line-height: 1.05;
    margin-bottom: 1.75rem;
  }
  .hero-title .line {
    display: block;
    opacity: 0;
    animation: fade-up 0.8s ease forwards;
  }
  .hero-title .line:nth-child(1) { animation-delay: 0.35s; }
  .hero-title .line:nth-child(2) { animation-delay: 0.5s; }
  .hero-title .line:nth-child(3) { animation-delay: 0.65s; }
  .hero-title .accent { color: var(--accent-light); }

  .hero-sub {
    color: rgba(255,255,255,0.7);
    font-size: 1.1rem;
    max-width: 440px;
    margin-bottom: 2.5rem;
    opacity: 0;
    animation: fade-up 0.8s 0.8s ease forwards;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    opacity: 0;
    animation: fade-up 0.8s 0.95s ease forwards;
    margin-bottom: 1.5rem;
  }
  .trust-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    opacity: 0;
    animation: fade-up 0.8s 1.05s ease forwards;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 100px;
    padding: 0.35rem 0.85rem;
    color: rgba(255,255,255,0.75);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    backdrop-filter: blur(6px);
  }
  .badge svg { color: var(--accent-light); flex-shrink: 0; }
  .btn-primary {
    text-decoration: none;
    background: var(--accent);
    color: white;
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0.85rem 2rem;
    border-radius: 100px;
    letter-spacing: 0.02em;
    transition: background 0.2s, transform 0.2s;
  }
  .btn-primary:hover { background: var(--accent-light); transform: translateY(-2px); }
  .btn-ghost {
    text-decoration: none;
    color: white;
    font-weight: 500;
    font-size: 0.95rem;
    padding: 0.85rem 2rem;
    border-radius: 100px;
    border: 1.5px solid rgba(255,255,255,0.35);
    backdrop-filter: blur(8px);
    transition: border-color 0.2s, background 0.2s;
  }
  .btn-ghost:hover { border-color: white; background: rgba(255,255,255,0.08); }

  /* stats strip */
  .hero-stats {
    position: relative;
    z-index: 1;
    background: rgba(18,17,15,0.6);
    backdrop-filter: blur(12px);
    border-top: 1px solid rgba(255,255,255,0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem 2rem;
    gap: 0;
    opacity: 0;
    animation: fade-up 0.8s 1.1s ease forwards;
  }
  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 3rem;
  }
  .stat-num {
    font-family: 'Playfair Display', serif;
    font-size: 2rem;
    font-weight: 700;
    color: white;
    line-height: 1;
  }
  .stat-label {
    font-size: 0.75rem;
    color: rgba(255,255,255,0.55);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-top: 0.35rem;
  }
  .stat-divider {
    width: 1px;
    height: 40px;
    background: rgba(255,255,255,0.15);
    flex-shrink: 0;
  }

  /* scroll hint */
  .scroll-hint {
    position: absolute;
    bottom: 6rem;
    right: 2rem;
    z-index: 1;
    opacity: 0;
    animation: fade-up 0.8s 1.3s ease forwards;
  }
  .scroll-hint span {
    display: block;
    width: 1.5px;
    height: 60px;
    background: linear-gradient(to bottom, transparent, rgba(255,255,255,0.6));
    animation: scroll-line 1.8s ease infinite;
  }
  @keyframes scroll-line {
    0%   { transform: scaleY(0); transform-origin: top; opacity: 1; }
    50%  { transform: scaleY(1); transform-origin: top; opacity: 1; }
    100% { transform: scaleY(1); transform-origin: bottom; opacity: 0; }
  }

  @keyframes fade-up {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 768px) {
    .hero-content { padding: 5rem 1.25rem 1.5rem; }
    .hero-title { font-size: clamp(2.6rem, 10vw, 4rem); }
    .hero-actions { flex-direction: column; align-items: flex-start; margin-bottom: 1.25rem; }
    .trust-badges { gap: 0.45rem; }
    .badge { font-size: 0.74rem; }
    .btn-primary, .btn-ghost {
      width: 100%;
      text-align: center;
      justify-content: center;
      min-height: 48px;
      display: flex;
      align-items: center;
    }
    .hero-stats {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0;
      padding: 0;
    }
    .stat {
      padding: 1.1rem 0.75rem;
      border-right: 1px solid rgba(255,255,255,0.1);
      border-bottom: 1px solid rgba(255,255,255,0.1);
    }
    .stat:nth-child(2n) { border-right: none; }
    .stat:nth-last-child(-n+2) { border-bottom: none; }
    .stat-num { font-size: 1.6rem; }
    .stat-divider { display: none; }
    .scroll-hint { display: none; }
  }
</style>
